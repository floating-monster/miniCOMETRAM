.meas tran r0_after0_qb FIND v(xtop.a_19896_8041.t0) AT=33n
.meas tran r1_after0_q FIND v(xtop.a_20000_14483.t0) AT=33n
.meas tran r1_after0_qb FIND v(xtop.a_19896_16041.t0) AT=33n
.meas tran r0_after1_q FIND v(xtop.a_20000_6483.t0) AT=47n
